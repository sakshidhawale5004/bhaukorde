# ==============================================================================
# BHAU KORDE MASALE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# .env is strictly ignored by Git and will NEVER be pushed to GitHub.
# ==============================================================================

# Server Port
PORT=3000

# Primary Notification Recipient
NOTIFICATION_EMAIL=bhaukorde1975@gmail.com

# ------------------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY CREDENTIALS
# (Obtain from Razorpay Dashboard > Settings > API Keys)
# ------------------------------------------------------------------------------
# Public Key ID (safe for frontend checkout modal, e.g. rzp_live_... or rzp_test_...)
RAZORPAY_KEY_ID=

# Private Key Secret (STRICTLY PRIVATE - Used only on server backend)
RAZORPAY_KEY_SECRET=

# Environment Mode: live or test
RAZORPAY_MODE=live

# Business / Merchant Brand Name
RAZORPAY_MERCHANT_NAME=Bhau Korde Masale

# ------------------------------------------------------------------------------
# SMTP EMAIL NOTIFICATION CREDENTIALS (GMAIL SMTP)
# ------------------------------------------------------------------------------
# Gmail SMTP Host and Port
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Sender Email Address
SMTP_USER=bhaukorde1975@gmail.com

# Gmail App Password (16-character password generated from Google Account > Security > App Passwords)
# NOTE: Do NOT use your regular Gmail login password; use a 16-character Google App Password.
SMTP_PASS=

# Sender Display Name
SMTP_FROM_NAME=Bhau Korde Masale Orders
